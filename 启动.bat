@echo off
REM ==========================================================================
REM  PhotoBak - start (source edition)
REM
REM  ASCII-only on purpose: see the note in "install-deps" batch file.
REM  Chinese UI text is produced by the Python program itself.
REM
REM  Want different defaults? Do NOT edit this file - edit "config" instead
REM  (the UTF-8 text file next to it whose name is in Chinese).
REM
REM  Extra arguments are forwarded, e.g.:
REM      start.bat --dry-run
REM      start.bat --usb
REM      start.bat --no-gui
REM ==========================================================================

chcp 65001 >nul
title PhotoBak
cd /d "%~dp0"

set "PY="
if exist ".venv\Scripts\python.exe" set "PY=.venv\Scripts\python.exe"
if not defined PY if defined PHOTOBAK_PYTHON set "PY=%PHOTOBAK_PYTHON%"
if not defined PY (
    where py >nul 2>nul && set "PY=py -3"
)
if not defined PY (
    where python >nul 2>nul && set "PY=python"
)

if not defined PY (
    type "tools\messages\no_python.txt"
    echo.
    pause
    exit /b 1
)

REM Dependency pre-check: fail fast with a clear pointer instead of a raw ImportError
%PY% -c "import fastapi, uvicorn" >nul 2>nul
if errorlevel 1 (
    type "tools\messages\need_deps.txt"
    echo.
    pause
    exit /b 1
)

REM Force UTF-8 so Chinese text and emoji render correctly in the console
set PYTHONIOENCODING=utf-8
set PYTHONUTF8=1

%PY% "run.py" %*
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
    type "tools\messages\exit_hint.txt"
    echo    exit code: %RC%
    echo.
    pause
)
exit /b %RC%
