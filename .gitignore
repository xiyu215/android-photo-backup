# ===========================================================================
# 安卓相册备份工具 —— Git 忽略规则
#
# 原则：仓库里只放「源码 + 文档 + 打包好的 zip」。
#       一切能由 build.bat 重新生成的东西、以及运行时数据，都不进仓库。
# ===========================================================================

# ---- 构建产物 ----------------------------------------------------------
build/                    # PyInstaller 中间产物（约 22 MB，可完全重建）
dist/*                    # 构建输出工作目录
!dist/*.zip               # ……但交付用的两个 zip 要保留

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
pip-log.txt

# ---- 测试 / 类型检查缓存 -----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- 运行时数据（程序在备份根目录下生成的）------------------------------
.photobak/                # 索引库、日志、报告、临时分片
*.db
*.db-journal
*.sqlite
*.sqlite3
logs/
*.log

# ---- 开发过程中的临时脚本 ----------------------------------------------
_verify*.py               # 交付验收脚本，跑完即删
_prev_*                   # 重打包前挪走的旧产物
*.tmp
*.bak
*~

# ---- 编辑器 / 系统 ------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
